{
  "name": "proxy-mapper-desktop",
  "version": "0.1.0",
  "description": "Desktop wrapper for proxy-mapper (MiniMax).",
  "private": true,
  "main": "dist/main/index.js",
  "author": "Anomaly",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "copy-proxy": "node scripts/copy-proxy.js",
    "prebuild": "npm run copy-proxy",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "clean:dist": "node scripts/clean-dist.js",
    "prepackage:win": "npm run clean:dist",
    "app:dir": "npm run clean:dist && npm run build && electron-builder --dir",
    "app:dist": "npm run clean:dist && npm run build && electron-builder",
    "package:win": "npm run clean:dist && npm run build && electron-builder --win --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-spawn": "^7.0.6",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "react-virtuoso": "^4.10.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.5",
    "vite-plugin-electron": "^0.28.7"
  }
}
